# ==============================================================================
# ITCC WISUDA SYNC - FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Salin file ini menjadi .env.local di dalam folder frontend/
# Contoh: copy .env.example .env.local

# --- KONEKSI FASTAPI BACKEND ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- KONEKSI SUPABASE CLIENT (BROWSER & SSR) ---
# Diambil dari Supabase Dashboard -> Project Settings -> API
# 1. Project URL (URL publik API Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Project API Key (Anon / Public Key)
# Aman digunakan di browser / client-side Next.js
# Diambil dari Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "anon (public)"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-public-key
