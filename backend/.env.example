# ==============================================================================
# ITCC WISUDA SYNC - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Salin file ini menjadi .env di dalam folder backend/
# Contoh: copy .env.example .env

# --- APLIKASI FASTAPI ---
APP_NAME="ITCC Wisuda Synchronization API"
APP_ENV=development
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_SIZE_BYTES=10485760

# --- KONEKSI SUPABASE REST / ADMIN API ---
# Diambil dari Supabase Dashboard -> Project Settings -> API
# 1. Project URL (contoh: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Service Role Secret Key (PERINGATAN: RAHASIA, JANGAN DIBAGIKAN KE CLIENT/BROWSER)
# Digunakan oleh backend untuk operasi admin, bypass RLS, dan registrasi petugas.
# Diambil dari Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "service_role (secret)"
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# --- KONEKSI DIRECT POSTGRESQL / MIGRATION (OPSIONAL / DATABASE CLI) ---
# Diambil dari Supabase Dashboard -> Project Settings -> Database -> Connection String
# Digunakan untuk menjalankan migrasi skrip psql secara langsung via terminal/CLI
# Format Direct Connection (Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Format Transaction Pooler (Port 6543):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
